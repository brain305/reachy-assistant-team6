# 이 파일을 .env 로 복사해서 값을 채우세요:  cp .env.example .env
# .env 는 커밋되지 않습니다. 이 파일(.env.example)에는 실제 키를 넣지 마세요.

# [필수] https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=

# [선택] 아래는 비워 두면 기본값 사용
# GEMINI_MODEL=gemini-3.8-flash
# STT_MODEL=large-v3-turbo
# STT_DEVICE=cpu
# TTS_VOICE=ko-KR-SunHiNeural
# TTS_RATE=+0%
