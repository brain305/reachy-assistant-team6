# 이 파일을 .env 로 복사해서 값을 채우세요:  cp .env.example .env
# .env 는 커밋되지 않습니다. 이 파일(.env.example)에는 실제 키를 넣지 마세요.

# [필수] https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=

# [선택] 아래는 비워 두면 기본값 사용
# GEMINI_MODEL=gemini-3.8-flash
# STT_MODEL=large-v3-turbo
# STT_DEVICE=cpu
# TTS_VOICE=ko-KR-SunHiNeural
# TTS_RATE=+0%

# [선택] Slack Incoming Webhook. 뉴스 요약을 Slack으로 전송할 때만 사용
# Slack 앱의 Incoming Webhooks에서 발급한 https://hooks.slack.com/services/... 주소
# URL은 비밀번호처럼 비공개로 관리하세요. 이 파일에는 실제 URL을 적지 마세요.
SLACK_WEBHOOK_URL=

# [선택] 카메라 입력: auto / device / file / bridge (기본 auto)
# Windows: device -> DirectShow, Linux: device -> V4L2
# WSL에서 카메라 장치가 없으면 file 또는 bridge 모드를 선택하세요.
# REACHY_CAMERA_SOURCE=file
# REACHY_CAMERA_IMAGE=/home/user/photos/sample.jpg
# REACHY_CAMERA_INDEX=0

# [선택] WSL에서 Windows 웹캠을 이용하기 위한 브리지 (Windows와 WSL에 동일 토큰 설정)
# REACHY_CAMERA_SOURCE=bridge
# REACHY_CAMERA_BRIDGE_URL=http://127.0.0.1:8765
# REACHY_CAMERA_BRIDGE_TOKEN=여기에_긴_무작위_토큰
# Windows 측 서버 실행 설정 (외부 인터넷에 포트를 공개하지 마세요)
# REACHY_CAMERA_BRIDGE_BIND=127.0.0.1
# REACHY_CAMERA_BRIDGE_PORT=8765
