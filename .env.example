# 비밀정보: 실제 값은 .env에만 저장하고 GitHub에는 올리지 마세요.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# STT_MODEL=large-v3-turbo
# STT_DEVICE=cpu
# TTS_VOICE=ko-KR-SunHiNeural
# TTS_RATE=+0%

# Slack 전송 기능을 사용할 때만 필요
SLACK_WEBHOOK_URL=

# 카메라 입력: auto / device / file / bridge
# Windows 기본값은 device, WSL에서 장치를 사용할 수 없으면 file 또는 bridge 설정
# REACHY_CAMERA_SOURCE=file
# REACHY_CAMERA_IMAGE=/home/user/photos/sample.jpg
# REACHY_CAMERA_INDEX=0

# Windows 카메라 브리지 사용 시 Windows + WSL .env에 같은 토큰 설정
# REACHY_CAMERA_SOURCE=bridge
# REACHY_CAMERA_BRIDGE_URL=http://127.0.0.1:8765
# REACHY_CAMERA_BRIDGE_TOKEN=직접_만든_긴_랜덤_문자열
# Windows 브리지 기본 바인딩은 127.0.0.1 (WSL NAT에서 접근 안 되면 아래 설정 참고)
# REACHY_CAMERA_BRIDGE_BIND=127.0.0.1
# REACHY_CAMERA_BRIDGE_PORT=8765
